# Copy to .env and fill in.

# Port the API listens on
PORT=4000

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite database file path (relative to server/)
DATABASE_PATH=./data/fitness.db

# Anthropic API key for the AI coach. If unset, the coach runs in a
# graceful "offline" mode with rule-based replies instead of Claude.
ANTHROPIC_API_KEY=
