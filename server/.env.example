# Copy to .env and fill in.

# Port the API listens on
PORT=4000

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite database file path (relative to server/)
DATABASE_PATH=./data/fitness.db

# Anthropic API key for the AI coach. If unset, the coach runs in a
# graceful "offline" mode with rule-based replies instead of Claude.
ANTHROPIC_API_KEY=

# Back-office admin account, seeded/promoted on boot. Set both to enable
# the admin dashboard login. Use a strong password in production.
ADMIN_EMAIL=admin@yourbrand.com
ADMIN_PASSWORD=change-me

# Stripe billing (optional). If unset, /api/billing/checkout runs in dev/mock
# mode and activates the tier immediately (great for testing the paywall).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public base URL of the customer app (used for Stripe success/cancel redirects)
APP_URL=
